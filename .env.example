# ── Required ──────────────────────────────────────────────────────────────────
# Your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Email address that receives the daily digest
DIGEST_RECIPIENT=your-email@example.com

# Gmail account used to fetch and send (must match your OAuth credentials)
GMAIL_SENDER=your-gmail@gmail.com

# ── Optional — sensible defaults shown ────────────────────────────────────────
# Maximum number of newsletter emails to process per run
# MAX_NEWSLETTERS=20

# How many hours back to look for newsletters
# LOOKBACK_HOURS=24

# Path to the OAuth token file (created on first run)
# GMAIL_TOKEN_FILE=token.json

# Path to the OAuth credentials JSON downloaded from Google Cloud Console
# GMAIL_CREDS_FILE=credentials.json

# Logging level: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# Log format: text (human-readable) | json (structured, for production)
# LOG_FORMAT=text

# Path to the deduplication state file
# SENT_DIGESTS_FILE=sent_digests.json

# Comma-separated list of sender addresses or domains to always skip
# Example: BLOCKLIST_SENDERS=spam@domain.com,newsletter@unwanted.com
# BLOCKLIST_SENDERS=

# Extra newsletter senders/domains to include (supplements the built-in list)
# Example: NEWSLETTER_SENDERS=digest@example.com,anothernewsletter.com
# NEWSLETTER_SENDERS=

# Target max words per article summary (default 250; try 150 or 350 to experiment)
# SUMMARY_MAX_WORDS=250
